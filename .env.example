APP_URL=https://hyperdriver.example.com
DATABASE_FILE=data/hyperdriver.sqlite
UPLOADS_DIR=data/uploads
REPLAY_QUOTA_BYTES=1073741824
REPLAY_QUOTA_COUNT=500
CARD_CATALOG_API_URL=https://api.goagain.dev/v1/cards
COLLECTIVE_ANALYSIS_ENABLED=true
# Obrigatório (mín. 32 caracteres) para o dataset coletivo em produção; sem ele, a coleta derivada é desativada.
ANALYSIS_PSEUDONYM_SALT=
# Versões opcionais para substituir os padrões versionados no código.
DECISION_EVALUATOR_VERSION=hybrid-rules-1.1.0
CARD_CATALOG_VERSION=talishar-card-identifiers-2026-08-25
FAB_RULES_VERSION=fab-comprehensive-rules-2026-08-25
TALISHAR_COMPATIBLE_COMMIT=4e062d6bfefbe2be1941fb639395624d35af47d4
# Defina apenas no primeiro boot e remova depois que o admin for criado.
ADMIN_INITIAL_PASSWORD=
