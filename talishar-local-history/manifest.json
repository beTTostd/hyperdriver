{
  "manifest_version": 3,
  "name": "Hyperdriver — Histórico Talishar",
  "version": "1.5.1",
  "description": "Captura partidas do Talishar e sincroniza replays completos com o Hyperdriver.",
  "permissions": ["downloads", "offscreen", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.talishar.net/*",
    "https://*.hyperdriver.com.br/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Hyperdriver — Histórico Talishar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.talishar.net/*"],
      "js": ["decision-capture-utils.js", "page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.talishar.net/*"],
      "js": ["capture-session-utils.js", "content-script.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.hyperdriver.com.br/*"],
      "css": ["sync-content-script.css"],
      "js": ["sync-content-script-utils.js", "sync-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
