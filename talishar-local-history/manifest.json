{
  "manifest_version": 3,
  "name": "Talishar Local History",
  "version": "0.1.1",
  "description": "Captura localmente o histórico de partidas do Talishar e exporta arquivos JSON.",
  "permissions": ["downloads", "storage"],
  "host_permissions": ["https://talishar.net/*", "https://api.talishar.net/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Talishar Local History",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://talishar.net/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://talishar.net/*"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
