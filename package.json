{
  "name": "talishar-match-replay",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "codex-supervisor": "codex-supervisor/dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "npm run db:migrate && next dev --hostname 0.0.0.0",
    "build": "npm run supervisor:build && bash scripts/build-verified.sh",
    "start": "next start --hostname 0.0.0.0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "build:extension": "node scripts/build-extension-zip.mjs",
    "verify:extension": "node scripts/verify-extension-zip.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:backfill": "node scripts/backfill-replays.mjs",
    "db:cleanup": "node scripts/cleanup-quarantine.mjs",
    "db:seed": "node scripts/seed.mjs",
    "backup": "node scripts/backup.mjs",
    "backup:verify": "node scripts/backup.mjs --verify-latest",
    "supervisor": "npm run supervisor:build --silent && node codex-supervisor/dist/cli.js",
    "supervisor:build": "tsc -p codex-supervisor/tsconfig.json"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Talishar Match Replay"
}
